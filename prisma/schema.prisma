generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Clicia")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([phone])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  durationMin  Int           @default(60)
  priceCents   Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(cuid())
  clientId    String
  serviceId   String
  startsAt    DateTime
  endsAt      DateTime
  priceCents  Int
  status      AppointmentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@index([status])
}

model Availability {
  id          String   @id @default(cuid())
  weekday     Int      @unique
  enabled     Boolean  @default(false)
  startTime   String
  endTime     String
  intervalMin Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlockedPeriod {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, endsAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
